{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Host Registry",
  "type": "object",
  "required": ["schemaVersion", "generatedFrom", "hosts"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "generatedFrom": {
      "type": "object",
      "required": ["repository", "pinnedRevision", "upstreamFile"],
      "properties": {
        "repository": { "type": "string" },
        "pinnedRevision": { "type": "string" },
        "upstreamFile": { "type": "string" },
        "fetchedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hosts": {
      "type": "array",
      "items": { "$ref": "#/definitions/host" }
    }
  },
  "definitions": {
    "host": {
      "type": "object",
      "required": ["id", "name", "displayName", "destinations", "aliases", "platforms", "detection", "attribution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "name": { "type": "string" },
        "displayName": { "type": "string", "minLength": 1 },
        "destinations": {
          "type": "object",
          "required": ["project", "global"],
          "properties": {
            "project": { "$ref": "#/definitions/destination" },
            "global": { "$ref": "#/definitions/destination" }
          }
        },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "detection": {
          "type": "object",
          "required": ["envVars"],
          "properties": {
            "envVars": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
          }
        },
        "attribution": {
          "type": "object",
          "required": ["upstreamFile", "upstreamLine"],
          "properties": {
            "upstreamFile": { "type": "string" },
            "upstreamLine": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "destination": {
      "oneOf": [
        { "type": "object", "required": ["kind", "path"], "properties": { "kind": { "enum": ["literal"] }, "path": { "type": "string" }, "raw": { "type": "string" } } },
        { "type": "object", "required": ["kind", "base", "segments"], "properties": { "kind": { "enum": ["join"] }, "base": { "type": "string" }, "segments": { "type": "array", "items": { "type": "string" } }, "raw": { "type": "string" } } },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["none"] }, "raw": { "type": "string" } } },
        { "type": "object", "required": ["kind", "base", "cases"], "properties": { "kind": { "enum": ["conditional"] }, "base": { "type": ["string", "null"] }, "cases": { "type": "array" } } }
      ]
    }
  }
}
