# The model this box serves: the one place for these values. Every box script reads them; set them once per project.
MODEL_ID="<org/checkpoint on Hugging Face>"
MODEL_REVISION="<commit of that checkpoint>"
MODEL_DIR="/root/.cache/huggingface/local/<folder>"
SERVED_NAME="<the name clients send>"
# The engine's parsers for this model's reasoning and tool calls (they change with the model).
REASONING_PARSER="<reasoning parser id>"
TOOL_PARSER="<tool-call parser id>"
# Optional: a second checkpoint whose shards overwrite edited base shards. Empty: none.
OVERLAY_ID=""
