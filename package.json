{
  "name": "@djordje-stojanovic/sigmaskills",
  "version": "0.2.0",
  "description": "Portable Agent Skills monorepo and first-party Sigma Installer",
  "type": "module",
  "bin": {
    "sigmaskills": "bin/sigmaskills.js"
  },
  "files": [
    "bin",
    "src",
    "registry/agent-hosts.json",
    "registry/source.json",
    "registry/schema.json",
    "registry/skill-baselines.json",
    "manifest.json",
    "sigmareview",
    "sigmaperformance",
    "sigmabrief",
    "sigmawrite",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Djordje-Stojanovic/Sigmaskills.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node ./src/prepack.js",
    "test": "node scripts/run-tests.js",
    "registry:sync": "node ./src/registry/sync.js",
    "registry:validate": "node ./test/registry-validate-cli.mjs"
  }
}
